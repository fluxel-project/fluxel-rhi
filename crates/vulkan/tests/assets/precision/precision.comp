#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require

layout(constant_id = 0) const float16_t half_value = float16_t(0.0);
layout(constant_id = 1) const int8_t byte_value = int8_t(0);

layout(std430, set = 0, binding = 0) buffer Data {
    uint result;
    float16_t stored_half;
    int16_t stored_short;
    int8_t stored_byte;
} data;

layout(local_size_x = 1) in;

void main() {
    data.stored_half = half_value;
    data.stored_short = int16_t(byte_value);
    data.stored_byte = byte_value;
    data.result = uint(half_value) + uint(byte_value);
}
