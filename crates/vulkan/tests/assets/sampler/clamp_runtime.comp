#version 450
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x=1) in;
layout(set=0,binding=7) uniform sampler sam[];
layout(set=0,binding=1) uniform utexture2D integer_texture;
layout(set=0,binding=2) uniform texture2D float_texture;
layout(set=0,binding=3,std430) buffer Results { uint result[]; } o;
void main(){
 uint i=nonuniformEXT(gl_GlobalInvocationID.x);
 o.result[0]=textureLod(usampler2D(integer_texture,sam[i]),vec2(1.5,0.5),0).r;
 o.result[1]=textureLod(usampler2D(integer_texture,sam[i]),vec2(0.5,0.5),0).r;
 o.result[2]=floatBitsToUint(textureLod(sampler2D(float_texture,sam[i]),vec2(1.5,0.5),0).r);
 o.result[3]=floatBitsToUint(textureLod(sampler2D(float_texture,sam[i]),vec2(0.5,0.5),0).r);
}
