#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform sampler sam;
layout(set=0,binding=2) uniform texture2D float_texture;
layout(set=0,binding=3,std430) buffer Results { uint result[]; } o;
void main(){
 o.result[2]=floatBitsToUint(textureLod(sampler2D(float_texture,sam),vec2(1.5,0.5),0).r);
 o.result[3]=floatBitsToUint(textureLod(sampler2D(float_texture,sam),vec2(0.5,0.5),0).r);
}
